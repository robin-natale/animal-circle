---
import { siteConfig } from "../../config/site.config";
export interface Props {
  href?: string;
}

const { href = "/" } = Astro.props as Props;
const { light, dark } = siteConfig.branding.logo;
---

<a href={href} class="logo" aria-label={siteConfig.name}>
  <img
    src={light}
    alt={siteConfig.name}
    class="logo__img logo__img--light"
    width="140"
    height="28"
  />
  <img
    src={dark}
    alt={siteConfig.name}
    class="logo__img logo__img--dark"
    width="140"
    height="28"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .logo:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .logo__img {
    height: 1.75rem;
    width: auto;
    display: block;
  }

  .logo__img--dark {
    display: none;
  }

  /* ThemeToggle adds/removes the `dark` class on <html>. */
  :global(html.dark) .logo__img--light {
    display: none;
  }

  :global(html.dark) .logo__img--dark {
    display: block;
  }

  /* Keep the header compact on very small screens. */
  @media (max-width: 20rem) {
    .logo__img {
      height: 1.5rem;
    }
  }
</style>
